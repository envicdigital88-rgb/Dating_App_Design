# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Dialog Genie / Dialog Pay Business. Copy App Key exactly from Connect.
# Live and sandbox use different keys. Do not use the merchant dashboard URL,
# a Markdown link, or the website URL as the API URL.
GENIE_ENV="production"
GENIE_API_URL="https://api.geniebiz.lk"
GENIE_APP_KEY=""
NEXT_PUBLIC_APP_URL="https://www.winglemingle.com"

# For sandbox use GENIE_ENV="sandbox" and
# GENIE_API_URL="https://api.uat.geniebiz.lk" with a sandbox App Key.
